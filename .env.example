# Clave gratuita de Google Gemini (Obtenla en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini seleccionado (gemini-2.5-pro es el más potente para investigación, gemini-2.5-flash es más rápido)
GEMINI_MODEL=gemini-2.5-pro

# Clave opcional para NewsAPI (si deseas usarla además de Google News y DuckDuckGo)
NEWSAPI_KEY=
